// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String           @id @default(cuid())
  githubId        String?          @unique
  email           String           @unique
  username        String           @unique
  password        String?
  createdAt       DateTime         @default(now())
  hostedMatches   Match[]          @relation("MatchHost")
  joinedMatches   Match[]          @relation("MatchGuest")
  wonMatches      Match[]          @relation("MatchWinner")
  activeMatchSlot ActiveMatchSlot?
  submissions     Submission[]
}

enum MatchStatus {
  WAITING
  IN_PROGRESS
  FINISHED
  CANCELLED
}

model Match {
  id     String      @id @default(cuid())
  status MatchStatus @default(WAITING)

  hostId String
  host   User   @relation("MatchHost", fields: [hostId], references: [id], onDelete: Cascade)

  guestId String?
  guest   User?   @relation("MatchGuest", fields: [guestId], references: [id], onDelete: SetNull)

  winnerId String?
  winner   User?   @relation("MatchWinner", fields: [winnerId], references: [id], onDelete: SetNull)

  problemId String
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Restrict)

  createdAt        DateTime          @default(now())
  startedAt        DateTime?
  endedAt          DateTime?
  endsAt           DateTime?
  activeMatchSlots ActiveMatchSlot[]
  submissions      Submission[]

  @@index([status, createdAt])
  @@index([problemId])
}

model ActiveMatchSlot {
  userId String  @id
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  ready  Boolean @default(false)

  matchId String
  match   Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([matchId])
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

model Problem {
  id            String     @id @default(cuid())
  slug          String     @unique
  title         String
  difficulty    Difficulty
  statement     String
  signature     Json
  timeLimitMs   Int
  memoryLimitMb Int
  createdAt     DateTime   @default(now())
  testCases     TestCase[]
  matches       Match[]
}

model TestCase {
  id             String  @id @default(cuid())
  input          Json
  expectedOutput Json
  isHidden       Boolean
  order          Int

  problemId String
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([problemId, order])
}

enum Verdict {
  ACCEPTED
  WRONG_ANSWER
  RUNTIME_ERROR
  TIME_LIMIT_EXCEEDED
  MEMORY_LIMIT_EXCEEDED
}

model Submission {
  id String @id @default(cuid())

  matchId String
  match   Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  code      String
  verdict   Verdict
  passed    Int
  total     Int
  createdAt DateTime @default(now())

  @@index([matchId, userId, createdAt])
}
