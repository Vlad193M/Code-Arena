// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id    String @id @default(cuid())
  githubId String? @unique
  email String @unique
  username String @unique
  password String?
  createdAt DateTime @default(now())
  hostedMatches Match[] @relation("MatchHost")
  joinedMatches Match[] @relation("MatchGuest")
}

enum MatchStatus {
  WAITING
  IN_PROGRESS
  FINISHED
  CANCELLED
}

model Match {
  id     String      @id @default(cuid())
  status MatchStatus @default(WAITING)

  hostId String
  host   User   @relation("MatchHost", fields: [hostId], references: [id], onDelete: Cascade)

  guestId String?
  guest   User?   @relation("MatchGuest", fields: [guestId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  startedAt DateTime?
  endedAt   DateTime?

  @@index([status, createdAt])
}